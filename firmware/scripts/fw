#!/usr/bin/env bash
# macOS / Linux 용 진입점 : NCS 툴체인의 파이썬으로 fw.py 를 실행한다.
set -e
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

if [ -z "$NCS_ROOT" ]; then
  case "$(uname -s)" in
    Darwin) NCS_ROOT=/opt/nordic/ncs ;;
    *)      NCS_ROOT="$HOME/ncs" ;;
  esac
fi
export NCS_ROOT

PY=""
for c in "$NCS_ROOT"/toolchains/*/bin/python3 "$NCS_ROOT"/toolchains/*/usr/local/bin/python3; do
  if [ -x "$c" ]; then PY="$c"; break; fi
done
if [ -n "$PY" ]; then
  # 툴체인 파이썬은 자체 libpython*.so 를 쓴다 (시스템 python3 는 이 경로가 필요 없다).
  TC_ROOT="${PY%/usr/local/bin/python3}"
  [ "$TC_ROOT" = "$PY" ] && TC_ROOT="${PY%/bin/python3}"
  for d in "$TC_ROOT/lib" "$TC_ROOT/lib/x86_64-linux-gnu" "$TC_ROOT/usr/local/lib"; do
    [ -d "$d" ] && LD_LIBRARY_PATH="$d${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
  done
  export LD_LIBRARY_PATH
fi
[ -z "$PY" ] && PY="$(command -v python3 || true)"
if [ -z "$PY" ]; then
  echo "[fw] ERROR: python3 를 찾을 수 없음 (NCS_ROOT=$NCS_ROOT)" >&2
  exit 1
fi

exec "$PY" "$SCRIPT_DIR/fw.py" "$@"
