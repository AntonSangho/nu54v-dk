{
  // firmware/scripts/fw(.cmd) 를 호출한다. 터미널에서 직접 실행해도 동일하다.
  //   mac/linux : ../../scripts/fw build
  //   windows   : ..\..\scripts\fw.cmd build
  "version": "2.0.0",
  "options": {
    "cwd": "${workspaceFolder}"
  },
  "windows": {
    "command": "${workspaceFolder}\\..\\..\\scripts\\fw.cmd"
  },
  "command": "${workspaceFolder}/../../scripts/fw",
  "type": "shell",
  "presentation": {
    "reveal": "always",
    "panel": "shared",
    "clear": true
  },
  "tasks": [
    {
      "label": "Build",
      "args": ["build"],
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": { "base": "$gcc", "fileLocation": "absolute" }
    },
    {
      "label": "Rebuild (pristine)",
      "args": ["build", "-p"],
      "group": "build",
      "problemMatcher": { "base": "$gcc", "fileLocation": "absolute" }
    },
    {
      "label": "Flash",
      "args": ["flash"],
      "dependsOn": "Build",
      "problemMatcher": []
    },
    {
      "label": "DFU (serial)",
      "detail": "cli 포트(VCOM1) 자동 탐색 → 업로드 → test → 리셋 → confirm. 그 포트를 쓰는 프로그램(baram-term 등)은 먼저 닫는다",
      "args": ["dfu"],
      "dependsOn": "Build",
      "problemMatcher": []
    },
    {
      "label": "DFU (serial, 포트 선택)",
      "detail": "포트를 직접 고른다. 보드가 여러 대일 때. (Firmware Task Manager 확장이 목록을 띄운다)",
      "args": ["dfu", "--port", "${input:dfuPort}"],
      "dependsOn": "Build",
      "problemMatcher": []
    },
    {
      "label": "DFU (BLE)",
      "detail": "BLE 로 업로드 → test → 리셋 → confirm. 다른 프로그램이 BLE 로 연결 중이면 먼저 끊어야 한다",
      "args": ["dfu", "--transport", "ble"],
      "dependsOn": "Build",
      "problemMatcher": []
    },
    {
      "label": "Erase chip",
      "args": ["erase"],
      "problemMatcher": []
    },
    {
      "label": "Reset",
      "args": ["reset"],
      "problemMatcher": []
    },
    {
      "label": "Clean",
      "args": ["clean"],
      "problemMatcher": []
    },
    {
      "label": "Menuconfig",
      "args": ["menuconfig"],
      "presentation": { "focus": true },
      "problemMatcher": []
    },
    {
      "label": "Env info",
      "args": ["env"],
      "problemMatcher": []
    }
  ],
  // 포트 선택은 Firmware Task Manager 확장이 채운다 (baram-dev.firmware-task-manager).
  // 확장 없이 실행하면 VS Code 가 입력창을 띄우므로 auto 를 그대로 두면 자동 탐색한다.
  "inputs": [
    {
      "id": "dfuPort",
      "type": "command",
      "command": "firmware-task.pickSerialPort",
      "args": {
        "placeholder": "cli 포트 (VCOM1) 를 고른다. 취소하면 auto",
        "filter": "usbmodem|ttyACM|COM"
      }
    }
  ]
}